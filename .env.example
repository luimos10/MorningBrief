# Morning Market Brief — Environment Variables
# Copia este archivo como .env y completa con tus valores reales.
# NUNCA commitees el archivo .env al repositorio.

# Anthropic Claude API key (requerido)
# Obtener en: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Telegram Bot (recomendado para entrega del brief)
# 1. Habla con @BotFather en Telegram → /newbot → obtén el token
# 2. Envía un mensaje a tu bot, visita https://api.telegram.org/bot<TOKEN>/getUpdates
#    para obtener tu chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# NewsAPI (opcional — free tier en https://newsapi.org/)
NEWSAPI_KEY=

# Claude API — tuning de costo/calidad (valores por defecto entre paréntesis)
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_MAX_TOKENS=11000
# CLAUDE_THINKING=between_tools
# CLAUDE_EFFORT=medium
# CLAUDE_PROMPT_CACHE=0
